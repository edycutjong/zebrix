# ── Supabase ──────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Polygon ───────────────────────────────────────────────────
# Private key for the wallet trading on Polymarket
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WALLET_PRIVATE_KEY=your-private-key-here

# ── Polymarket CLOB API ───────────────────────────────────────
# API credentials must be derived from your wallet's private key.
# Run: `npx ts-node scripts/generate-clob-keys.ts`
# and paste the output below:
POLYMARKET_API_KEY=derived-api-key
POLYMARKET_API_SECRET=derived-api-secret
POLYMARKET_PASSPHRASE=derived-passphrase
