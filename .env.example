# ── Supabase ──────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Polymarket CLOB API ───────────────────────────────────────
# https://docs.polymarket.com/#authentication
POLYMARKET_API_KEY=your-api-key
POLYMARKET_API_SECRET=your-api-secret
POLYMARKET_PASSPHRASE=your-passphrase

# ── Polygon ───────────────────────────────────────────────────
# Private key for the wallet trading on Polymarket
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WALLET_PRIVATE_KEY=your-private-key-here
